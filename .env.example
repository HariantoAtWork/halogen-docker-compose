# Copy to .env:  cp .env.example .env
# Then:          docker compose up -d
#                # or: ./dc.sh up
#
# ── Model profile (exactly ONE block active) ─────────────────────────
# Switch: comment OUT the active block, comment IN another.
# Weights fetch on compose up (idempotent), or: ./dc.sh download
# Then restart serve:                       ./dc.sh restart
#
# HF_DOWNLOAD_SPECS lines are "repo|revision|artifact".
# artifact = Hub filename, or include:GLOB (e.g. include:tokenizer/*).
# All files land flat in MODELS_DIR (Halogen expects companions beside the checkpoint).
#
# Ordering: peonist-ai stock first (A, B), then non-peonist derivatives (C, D).

HF_TOKEN=
MODELS_DIR=./models
HF_DOWNLOADER_TAG=latest
HALOGEN_IMAGE_TAG=0.18.9
HALOGEN_HOST_PORT=8731

# NPU sidecars (comma-separated). Empty = Flash only.
HALOGEN_NPU_MODELS=decider-0.8b,qwen3-embedding-0.6b,qwen3-reranker-0.6b,qwen3guard-gen-0.6b,qwen3.5-2b

# ══ peonist-ai stock ═════════════════════════════════════════════════

# --- A) peonist stock v2 (default) ---
HF_DOWNLOAD_SPECS="
peonist-ai/halogen-qwen3.8-flash-next|main|qwen38-flash-next-v2.hgn
peonist-ai/halogen-qwen3.8-flash-next|main|qwen38-flash-next-ngram.hgn
peonist-ai/halogen-qwen3.8-flash-next|main|qwen38-flash-next-vision.hgn
peonist-ai/halogen-qwen3.8-flash-next|main|include:tokenizer/*
"
HALOGEN_DOWNLOAD=peonist-ai/halogen-qwen3.8-flash-next
HALOGEN_CHECKPOINT=/models/qwen38-flash-next-v2.hgn
HALOGEN_VISION_TOWER=/models/qwen38-flash-next-vision.hgn
HALOGEN_MODEL_ID=halogen-v2

# --- B) peonist stock HT43 (0.16+, smaller) ---
# HF_DOWNLOAD_SPECS="
# peonist-ai/halogen-qwen3.8-flash-next|main|qwen38-flash-next-ht43.hgn
# peonist-ai/halogen-qwen3.8-flash-next|main|qwen38-flash-next-ngram.hgn
# peonist-ai/halogen-qwen3.8-flash-next|main|qwen38-flash-next-vision.hgn
# peonist-ai/halogen-qwen3.8-flash-next|main|include:tokenizer/*
# "
# HALOGEN_DOWNLOAD=peonist-ai/halogen-qwen3.8-flash-next
# HALOGEN_CHECKPOINT=/models/qwen38-flash-next-ht43.hgn
# HALOGEN_VISION_TOWER=/models/qwen38-flash-next-vision.hgn
# HALOGEN_MODEL_ID=halogen-ht43

# ══ non-peonist (Quat3rnion abliterated) ═════════════════════════════

# --- C) Quat3rnion v2 abliterated ---
# Trunk from Quat3rnion; n-gram / vision / tokenizer from peonist.
# HF_DOWNLOAD_SPECS="
# Quat3rnion/halogen-qwen3.8-flash-next-v2-abliterated|main|qwen38-flash-next-v2-abliterated.hgn
# peonist-ai/halogen-qwen3.8-flash-next|5cc17cea1a10b502b4a5db41d8d2b1a0f22dba26|qwen38-flash-next-ngram.hgn
# peonist-ai/halogen-qwen3.8-flash-next|e053f488b120b99ed2525e6ac99f68c51b3b6179|qwen38-flash-next-vision.hgn
# peonist-ai/halogen-qwen3.8-flash-next|e053f488b120b99ed2525e6ac99f68c51b3b6179|include:tokenizer/*
# "
# HALOGEN_DOWNLOAD=Quat3rnion/halogen-qwen3.8-flash-next-v2-abliterated
